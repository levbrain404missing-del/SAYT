# Пример конфигурации. Скопировать в .env и заполнить:
#   cp .env.example .env
# Файл .env в репозиторий не попадает (см. .gitignore).

# --- сеть ---
# Порт и адрес, на котором слушает Node. За обратным прокси (Caddy/nginx)
# держать HOST=127.0.0.1, чтобы приложение не торчало в интернет напрямую.
PORT=3100
HOST=127.0.0.1

# --- внешний вид и ссылки ---
SITE_NAME=Demo Access
# Публичный адрес сайта: подставляется в ссылку восстановления пароля.
# Должен совпадать с тем, по которому реально открывается сайт.
PUBLIC_URL=https://example.com

# --- данные ---
DB_PATH=./data/app.db
MAIL_LOG=./data/mail.log

# --- безопасность ---
# ОБЯЗАТЕЛЬНО сгенерировать своё значение, не переиспользовать пример:
#   openssl rand -hex 32
SESSION_SECRET=replace-me-with-openssl-rand-hex-32
# 1 — cookie только по HTTPS (прод). 0 — разрешить http (локальная разработка).
SECURE_COOKIES=1

# --- восстановление пароля ---
# 1 — ссылка восстановления показывается прямо на странице и пишется в MAIL_LOG.
#     Это ДЕМО-режим: нужен, пока нет SMTP. В реальной эксплуатации — 0.
# 0 — ссылка только письмом (требует заполненных SMTP_* ниже).
SHOW_RESET_LINK=1

# --- SMTP (опционально) ---
# Пока не заполнено, письма не отправляются. Порт 465 = implicit TLS.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=465
#SMTP_USER=noreply@example.com
#SMTP_PASS=app-password-here
#SMTP_FROM=noreply@example.com
